# Atlas — settings for compose.public.yaml. Copy this file to .env next to
# compose.public.yaml and edit; anything left out uses the default shown.
# Every other setting: docs/configuration.md.

# The first admin. Created on first start only, and only while no admin exists.
# The password must be at least 12 characters; a shorter one is refused and
# the Atlas starts without an admin (the log says why).
ATLAS_ADMIN_USER=admin
ATLAS_ADMIN_PASSWORD=

# Where the Atlas listens on this machine. Loopback by default: put a reverse
# proxy with TLS in front to reach it from elsewhere (docs/install.md).
ATLAS_PUBLISH=127.0.0.1:5006

# The name on the sign-in page.
ATLAS_BRAND=The Atlas

# What a fresh install shows before you chart anything:
#   empty   an empty map and an invitation to survey it
#   bundled the demo lab that ships with the image (good for a first look)
ATLAS_FALLBACK=empty

# Ask for a second factor: blank (no), admins, or all.
ATLAS_MFA_REQUIRED=

# The reverse proxy in front of the Atlas, by address, so sign-in limits count
# real visitors rather than the proxy (docs/configuration.md).
ATLAS_TRUSTED_PROXIES=

# Plain http with no proxy (a LAN test only): 1 sends the session cookie
# without the Secure flag so browsers that refuse it on http still sign in.
ATLAS_INSECURE_COOKIES=
