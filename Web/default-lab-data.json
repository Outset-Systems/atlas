    },
    {
      "name": "Media Maintenance",
      "host": "MEDIA",
      "when": "daily 07:15",
      "cadence": "daily",
      "note": "Library scan and transcode clean-up."
    },
    {
      "name": "DNS Blocklist Update",
      "host": "DIRECTORY",
      "when": "03:30",
      "cadence": "daily",
      "note": "Refreshes the blocklists the DNS filter uses."
    },
    {
      "name": "Certificate Watch",
      "host": "MONITOR",
      "when": "06:00",
      "cadence": "daily",
      "note": "Warns when any certificate on the map is inside 21 days of expiry."
    },
    {
      "name": "The Weekly Report",
      "host": "MONITOR",
      "when": "Mon 13:00 UTC",
      "cadence": "weekly",
      "note": "Security and certificate summary, posted to the wiki.",
      "key": "the-weekly-report",
      "expect_every": "7d",
      "grace": "2d"
    },
    {
      "name": "Access Audit",
      "host": "all guests",
      "when": "Mon 13:30 UTC",
      "cadence": "weekly",
      "note": "Diffs accounts, keys and sudoers against each host's baseline."
    },
    {
      "name": "Pool Scrub",
      "host": "NAS",
      "when": "1st Sun 02:00",
      "cadence": "monthly",
      "note": "Reads every block and checks it against its checksum."
    },
    {
      "name": "The Morning Brief",
      "host": "INTERNAL HOST",
      "when": "13:00 UTC — 08:00 local",
      "cadence": "daily",
      "note": "A model summarises overnight alerts into one note.",
      "asks": "gpu-box",
      "model": "llama3.1:8b · 8k",
      "at": "13:00",
      "hold": 25
    },
    {
      "name": "The Hourly Triage",
      "host": "INTERNAL HOST",
      "when": "hourly at :35, 08:00–20:00 local",
      "cadence": "continuous",
      "note": "A model sorts new alerts by urgency.",
      "asks": "gpu-box",
      "model": "llama3.1:8b · 8k",
      "at": ":35",
      "between": "13:00–01:00",
      "hold": 5
    },
    {
      "name": "The Week in Review",
      "host": "INTERNAL HOST",
      "when": "Sun 22:00 UTC",
      "cadence": "weekly",
      "note": "A model writes the week's changes into the wiki.",
      "asks": "gpu-box",
      "model": "qwen3:14b · 32k",
      "at": "22:00",
      "days": "Sun",
      "hold": 15
    },
    {
      "name": "Config Commit",
      "host": "GATEWAY",
      "when": "on every save",
      "cadence": "continuous",
      "note": "The router's config is committed to git whenever it changes."
    },
    {
      "name": "Old Experiment",
      "host": "STANDBY",
