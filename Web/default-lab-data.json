    },
    {
      "name": "Hourly Snapshots",
      "host": "NAS",
      "when": "hourly :05",
      "cadence": "continuous",
      "note": "ZFS snapshots of every dataset, 48 hourly and 30 daily kept."
    },
    {
      "name": "The Patch Survey",
      "host": "all guests",
      "when": "Sun 04:15",
